rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // التحقق من البريد الموثق للمالك السيادي
    function isSovereignAdmin() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'omralabis@gmail.com';
    }

    // قراءة الدور من وثيقة المستخدم (RBAC)
    function userHasRole(roles) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    // صلاحية المدير (Admin)
    function isAdmin() {
      return isSovereignAdmin()
        || userHasRole(['admin'])
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // صلاحية الموظف أو المدير (Staff / Admin)
    function isStaff() {
      return isSovereignAdmin() || userHasRole(['admin', 'staff']);
    }

    // صلاحية مندوب التوصيل أو المدير (Driver / Admin)
    function isDriver() {
      return isSovereignAdmin() || userHasRole(['admin', 'driver']);
    }

    // فحص اتصال القاعدة الخفيف
    match /test/connection {
      allow get: if true;
    }

    // Admins: تقييد الوصول لقائمة المدراء بالمدراء المعتمدين فقط
    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    // Orders: حماية الطلبات، منع الإنشاء المجهول غير الموثق، وتقييد حقول تعديل المندوب
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (request.auth.uid == resource.data.userId || isStaff() || isDriver());
      allow list: if isStaff() || isDriver() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId)
        && isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total_amount is number
        && request.resource.data.total_amount >= 0
        && request.resource.data.customer_name is string
        && request.resource.data.customer_name.size() > 0
        && request.resource.data.customer_name.size() <= 150;
      allow update: if isValidId(orderId) && (
        isStaff()
        || (
          isDriver()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'delivery_status',
            'driver_name',
            'driver_phone',
            'driver_notes',
            'cod_collected',
            'cod_collected_amount',
            'delivered_at',
            'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Products: قراءة عامة للمتجر، والإنشاء والتعديل والحذف محصورة بالموظفين والمدراء فقط
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId)
        && isStaff()
        && request.resource.data.title_ar is string
        && request.resource.data.title_ar.size() > 0
        && request.resource.data.title_ar.size() <= 300
        && request.resource.data.original_price is number
        && request.resource.data.original_price > 0;
      allow delete: if isValidId(productId) && isStaff();
    }

    // Users: المستخدم يعدل حسابه فقط دون ترقية role، والأدمن يملك الصلاحية الكاملة
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isSignedIn()
        && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer');
      allow update: if isValidId(userId) && isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isAdmin()
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Cart & Favorites: خاصة بصاحب الحساب فقط
    match /users/{userId}/cart/{itemId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/favorites/{productId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Reviews: قراءة عامة، الإنشاء للمستخدم الموثق مع تحقق التقييم، والإدارة للأدمن
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId)
        && isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;
      allow update, delete: if isValidId(reviewId) && isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Supplier Intelligence Hub & Pricing AI: محصورة بالكامل بالمدير (isAdmin)
    match /supplier_ai_suppliers/{document=**} {
      allow read, write: if isAdmin();
    }
    match /supplier_ai_supplier_products/{document=**} {
      allow read, write: if isAdmin();
    }
    match /supplier_ai_price_observations/{document=**} {
      allow read, write: if isAdmin();
    }
    match /supplier_ai_conversations/{document=**} {
      allow read, write: if isAdmin();
    }
    match /supplier_ai_messages/{document=**} {
      allow read, write: if isAdmin();
    }
    match /supplier_product_drafts/{document=**} {
      allow read, write: if isAdmin();
    }
    match /supplier_ai_product_drafts/{document=**} {
      allow read, write: if isAdmin();
    }
    match /supplier_ai_imports/{document=**} {
      allow read, write: if isAdmin();
    }
    match /supplier_ai_supplier_documents/{document=**} {
      allow read, write: if isAdmin();
    }
    match /supplier_ai_purchase_links/{document=**} {
      allow read, write: if isAdmin();
    }

    // Pricing AI & Supplier Memory: محصورة بالكامل بالمدير (isAdmin)
    match /pricing_ai_conversations/{document=**} {
      allow read, write: if isAdmin();
    }
    match /pricing_ai_messages/{document=**} {
      allow read, write: if isAdmin();
    }
    match /pricing_ai_price_observations/{document=**} {
      allow read, write: if isAdmin();
    }
    match /pricing_ai_settings/{document=**} {
      allow read, write: if isAdmin();
    }
    match /pricing_ai_import_records/{document=**} {
      allow read, write: if isAdmin();
    }
    match /pricing_ai_recommendations/{document=**} {
      allow read, write: if isAdmin();
    }
    match /pricing_ai_purchase_groups/{document=**} {
      allow read, write: if isAdmin();
    }

    // Legacy suppliers and submission staging rules: محصورة بالمدير (isAdmin)
    match /suppliers/{document=**} {
      allow read, write: if isAdmin();
    }
    match /supplier_submissions/{document=**} {
      allow read, write: if isAdmin();
    }

    // Smart Employee Assistant Drafts: القراءة والإنشاء والتعديل والحذف محصورة بالمدير (تُدار مسودات الموظفين عبر خادم Express المحمي)
    match /ai_employee_drafts/{draftId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isValidId(draftId) && isAdmin();
    }

    // Accounting & Financial Audit System: محصورة بالكامل بالمدير (isAdmin) مع التحقق الصارم من الحقول
    match /accounting_products/{docId} {
      allow get, list: if isAdmin();
      allow create, update: if isValidId(docId)
        && isAdmin()
        && request.resource.data.keys().hasAll(['id', 'name', 'vendorCode', 'qty', 'landedCostSar', 'sellPriceSar', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 250
        && request.resource.data.qty is number
        && request.resource.data.qty >= 0
        && request.resource.data.landedCostSar is number
        && request.resource.data.landedCostSar >= 0
        && request.resource.data.sellPriceSar is number
        && request.resource.data.sellPriceSar >= 0;
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /accounting_sales/{docId} {
      allow get, list: if isAdmin();
      allow create, update: if isValidId(docId)
        && isAdmin()
        && request.resource.data.keys().hasAll(['id', 'referenceId', 'productName', 'qty', 'unitPriceSar', 'status', 'date', 'createdAt'])
        && request.resource.data.referenceId is string
        && request.resource.data.referenceId.size() > 0
        && request.resource.data.referenceId.size() <= 120
        && request.resource.data.qty is number
        && request.resource.data.qty > 0
        && request.resource.data.unitPriceSar is number
        && request.resource.data.unitPriceSar >= 0
        && request.resource.data.status in ['completed', 'returned'];
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /accounting_expenses/{docId} {
      allow get, list: if isAdmin();
      allow create, update: if isValidId(docId)
        && isAdmin()
        && request.resource.data.keys().hasAll(['id', 'referenceId', 'title', 'category', 'amountSar', 'date', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 250
        && request.resource.data.amountSar is number
        && request.resource.data.amountSar > 0;
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /accounting_suppliers/{docId} {
      allow get, list: if isAdmin();
      allow create, update: if isValidId(docId)
        && isAdmin()
        && request.resource.data.keys().hasAll(['id', 'referenceId', 'code', 'type', 'amountSar', 'date', 'createdAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 120
        && request.resource.data.type in ['purchase', 'payment']
        && request.resource.data.amountSar is number
        && request.resource.data.amountSar > 0;
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /accounting_ledger/{docId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(docId)
        && isAdmin()
        && request.resource.data.keys().hasAll([
          'id', 'tx_number', 'date', 'direction', 'category',
          'reference_type', 'reference_id', 'source_party',
          'payment_channel', 'amount_sar', 'created_at'
        ])
        && request.resource.data.tx_number is string
        && request.resource.data.tx_number.size() > 0
        && request.resource.data.tx_number.size() <= 64
        && request.resource.data.direction in ['in', 'out']
        && request.resource.data.reference_type in ['order', 'sale', 'expense', 'supplier', 'stock_purchase', 'manual']
        && request.resource.data.reference_id is string
        && request.resource.data.reference_id.size() > 0
        && request.resource.data.reference_id.size() <= 120
        && request.resource.data.source_party is string
        && request.resource.data.source_party.size() > 0
        && request.resource.data.source_party.size() <= 200
        && request.resource.data.amount_sar is number
        && request.resource.data.amount_sar > 0;
      allow update: if isValidId(docId)
        && isAdmin()
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.tx_number == resource.data.tx_number
        && request.resource.data.amount_sar is number
        && request.resource.data.amount_sar > 0;
      allow delete: if isValidId(docId) && isAdmin();
    }
  }
}
