{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "E-commerce product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title_ar": { "type": "string", "maxLength": 200 },
        "description_ar": { "type": "string", "maxLength": 2000 },
        "original_price": { "type": "number" },
        "discount_price": { "type": "number" },
        "stock_quantity": { "type": "number" },
        "category_id": { "type": "string", "maxLength": 50 },
        "category_name": { "type": "string", "maxLength": 100 },
        "image_url": { "type": "string", "maxLength": 1000 },
        "video_url": { "type": "string", "maxLength": 1000 },
        "tags": { "type": "array" },
        "rating": { "type": "number" },
        "reviews_count": { "type": "number" },
        "featured": { "type": "boolean" },
        "ai_generated": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title_ar", "original_price", "category_id", "image_url"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "User wishlist item",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "title_ar": { "type": "string", "maxLength": 200 },
        "price": { "type": "number" },
        "image_url": { "type": "string", "maxLength": 1000 },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "title_ar", "price", "image_url"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Item in user shopping cart",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "quantity": { "type": "number" },
        "title_ar": { "type": "string", "maxLength": 200 },
        "price": { "type": "number" },
        "image_url": { "type": "string", "maxLength": 1000 },
        "addedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "quantity", "title_ar", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Store customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "order_number": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "customer_name": { "type": "string", "maxLength": 100 },
        "customer_phone": { "type": "string", "maxLength": 30 },
        "customer_email": { "type": "string", "maxLength": 150 },
        "customer_city": { "type": "string", "maxLength": 50 },
        "customer_address": { "type": "string", "maxLength": 300 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "delivery_fee": { "type": "number" },
        "total_amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 20 },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"]
        },
        "payment_method": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "order_number", "userId", "customer_name", "customer_phone", "total_amount", "status", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "author": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "verifiedPurchase": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "userId", "author", "rating", "comment", "createdAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier registry document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 200 },
        "businessName": { "type": "string", "maxLength": 200 },
        "whatsappPhone": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "name", "whatsappPhone", "status"]
    },
    "PriceObservation": {
      "title": "PriceObservation",
      "description": "Historical price point for a product from a supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierCode": { "type": "string", "maxLength": 64 },
        "supplierName": { "type": "string", "maxLength": 200 },
        "supplierCost": { "type": "number" },
        "currency": { "type": "string", "maxLength": 20 },
        "calculatedSalePrice": { "type": "number" },
        "markupPercent": { "type": "number" },
        "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "observedAt": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productName", "supplierId", "supplierCost", "approvalStatus"]
    },
    "PricingConversation": {
      "title": "PricingConversation",
      "description": "Admin chat session for pricing and supplier intelligence",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "createdAt", "updatedAt"]
    },
    "PricingMessage": {
      "title": "PricingMessage",
      "description": "Message in a pricing conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "role", "content", "createdAt"]
    },
    "EmployeeDraft": {
      "title": "EmployeeDraft",
      "description": "Unpriced AI-extracted product draft submitted by an employee for admin pricing and review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "employee_code": {
          "type": "string",
          "enum": ["EMP001", "EMP002", "EMP003", "EMP004", "EMP005", "EMP006", "EMP007", "EMP008", "ADMIN"]
        },
        "title_ar": { "type": "string", "maxLength": 300 },
        "description_ar": { "type": "string", "maxLength": 4000 },
        "category_id": { "type": "string", "maxLength": 80 },
        "category_name": { "type": "string", "maxLength": 120 },
        "brand": { "type": "string", "maxLength": 150 },
        "size_or_volume": { "type": "string", "maxLength": 100 },
        "ingredients": { "type": "string", "maxLength": 2000 },
        "how_to_use": { "type": "string", "maxLength": 2000 },
        "tags": { "type": "array" },
        "image_url": { "type": "string", "maxLength": 900000 },
        "gallery_images": { "type": "array" },
        "source_type": {
          "type": "string",
          "enum": ["single_image", "multi_image_single_product", "batch_images", "video", "whatsapp_chat"]
        },
        "price": { "type": "number" },
        "original_price": { "type": "number" },
        "discount_price": { "type": "number" },
        "stock_quantity": { "type": "number" },
        "pricing_status_label": { "type": "string", "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["pending_pricing", "published"]
        },
        "published_product_id": { "type": "string", "maxLength": 128 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "employee_code", "title_ar", "status", "pricing_status_label", "created_at"]
    },
    "AccountingProduct": {
      "title": "AccountingProduct",
      "description": "Accounting inventory batch with landed cost in SAR",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 250 },
        "vendorCode": { "type": "string", "maxLength": 80 },
        "qty": { "type": "number" },
        "buyPriceSar": { "type": "number" },
        "shippingTotalSar": { "type": "number" },
        "landedCostSar": { "type": "number" },
        "sellPriceSar": { "type": "number" },
        "purchaseMode": { "type": "string", "enum": ["cash", "credit"] },
        "paymentChannel": { "type": "string", "maxLength": 60 },
        "supplierCode": { "type": "string", "maxLength": 80 },
        "referenceId": { "type": "string", "maxLength": 80 },
        "storeProductId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "vendorCode", "qty", "landedCostSar", "sellPriceSar", "createdAt"]
    },
    "AccountingSale": {
      "title": "AccountingSale",
      "description": "Recorded accounting sale linked to store order or manual invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "txNumber": { "type": "string", "maxLength": 64 },
        "referenceId": { "type": "string", "maxLength": 100 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 250 },
        "vendorCode": { "type": "string", "maxLength": 80 },
        "qty": { "type": "number" },
        "unitPriceSar": { "type": "number" },
        "unitCostSar": { "type": "number" },
        "feesSar": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "returned"] },
        "paymentChannel": { "type": "string", "maxLength": 60 },
        "sourceParty": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "format": "date" },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "referenceId", "productName", "qty", "unitPriceSar", "status", "date", "createdAt"]
    },
    "AccountingExpense": {
      "title": "AccountingExpense",
      "description": "Operating or advertising expense entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "txNumber": { "type": "string", "maxLength": 64 },
        "referenceId": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 250 },
        "category": { "type": "string", "maxLength": 100 },
        "amountSar": { "type": "number" },
        "paymentChannel": { "type": "string", "maxLength": 60 },
        "sourceParty": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "format": "date" },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "referenceId", "title", "category", "amountSar", "date", "createdAt"]
    },
    "AccountingSupplierTx": {
      "title": "AccountingSupplierTx",
      "description": "Supplier payable or cash settlement transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "txNumber": { "type": "string", "maxLength": 64 },
        "referenceId": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "enum": ["purchase", "payment"] },
        "amountSar": { "type": "number" },
        "paymentChannel": { "type": "string", "maxLength": 60 },
        "note": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "referenceId", "code", "type", "amountSar", "date", "createdAt"]
    },
    "AccountingLedgerEntry": {
      "title": "AccountingLedgerEntry",
      "description": "Auditable financial cashflow entry recording date, reference, counterparty, channel, and SAR amount",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tx_number": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "format": "date" },
        "direction": { "type": "string", "enum": ["in", "out"] },
        "category": { "type": "string", "maxLength": 100 },
        "reference_type": { "type": "string", "enum": ["order", "sale", "expense", "supplier", "stock_purchase", "manual"] },
        "reference_id": { "type": "string", "maxLength": 120 },
        "source_party": { "type": "string", "maxLength": 200 },
        "payment_channel": { "type": "string", "maxLength": 80 },
        "amount_sar": { "type": "number" },
        "original_amount": { "type": "number" },
        "currency_code": { "type": "string", "maxLength": 20 },
        "exchange_rate": { "type": "number" },
        "balance_after_sar": { "type": "number" },
        "notes": { "type": "string", "maxLength": 600 },
        "linked_record_id": { "type": "string", "maxLength": 128 },
        "is_manual": { "type": "boolean" },
        "created_by": { "type": "string", "maxLength": 150 },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "tx_number",
        "date",
        "direction",
        "category",
        "reference_type",
        "reference_id",
        "source_party",
        "payment_channel",
        "amount_sar",
        "created_at"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Admin authorization documents"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public products catalog"
    },
    "/users/{userId}/favorites/{productId}": {
      "schema": "Favorite",
      "description": "User saved favorites"
    },
    "/users/{userId}/cart/{productId}": {
      "schema": "CartItem",
      "description": "User shopping cart items"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store customer orders"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer reviews for products"
    },
    "/supplier_ai_suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Registry of cosmetics suppliers"
    },
    "/pricing_ai_price_observations/{obsId}": {
      "schema": "PriceObservation",
      "description": "Historical price tracking"
    },
    "/pricing_ai_conversations/{convId}": {
      "schema": "PricingConversation",
      "description": "Admin pricing chat sessions"
    },
    "/pricing_ai_messages/{msgId}": {
      "schema": "PricingMessage",
      "description": "Messages in pricing chat sessions"
    },
    "/ai_employee_drafts/{draftId}": {
      "schema": "EmployeeDraft",
      "description": "Employee-submitted AI product drafts awaiting admin pricing"
    },
    "/accounting_products/{docId}": {
      "schema": "AccountingProduct",
      "description": "Accounting inventory items with landed cost"
    },
    "/accounting_sales/{docId}": {
      "schema": "AccountingSale",
      "description": "Accounting sales register"
    },
    "/accounting_expenses/{docId}": {
      "schema": "AccountingExpense",
      "description": "Accounting operating expenses"
    },
    "/accounting_suppliers/{docId}": {
      "schema": "AccountingSupplierTx",
      "description": "Accounting supplier payables and payments"
    },
    "/accounting_ledger/{docId}": {
      "schema": "AccountingLedgerEntry",
      "description": "Full auditable cashflow ledger tracking every riyal in and out"
    }
  }
}
